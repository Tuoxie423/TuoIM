                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "条数，默认20",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/utils.Response"
                        }
                    }
                }
            }
        },
